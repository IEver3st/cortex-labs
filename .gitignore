# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
*.lcov
.nyc_output/

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional cache directories
.npm
.eslintcache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env
.env.*.local
.env.local

# Vite build output
/dist/

# Bun
.bun-cache/

# AI / Agent systems
# AGENTS.md is repository policy and is intentionally tracked.
.agents/
*.agents*
.claude/
.cursor/
.codex/
.devin/
.windsurf/
.v0/
.bolt/
.replit/
opencode/
superpowers/

# AI-generated files
*.ai.md
*.prompt.md
.prompts/
.context/

# Rust / Tauri build artifacts
target/
target-*/
src-tauri/target*/
src-tauri/target-codex-check/
**/*.pdb
**/*.rlib
**/*.rmeta

# .NET build artifacts (codewalker-bridge)
tools/codewalker-bridge/bin/
tools/codewalker-bridge/obj/

# Local tooling / session artifacts
.tmp/
/src/App.jsx.new
/tmp*
/replace_buttons*.cjs
/diff.patch

# One-off scratch / reference files not needed for production build
/colorpalette.md
/fix-css.ps1
/*.scratch.*
/notes*.md
/scratch*

# GTA V/FiveM source assets must never be committed.
*.[yY][dD][dD]
*.[yY][tT][dD]
