{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    {
      "identifier": "fs:allow-write-file",
      "deny": [
        { "path": "$HOME/[Aa][Pp][Pp][Dd][Aa][Tt][Aa]/**" },
        { "path": "$HOME/[Aa][Pp][Pp][Dd][Aa][Tt]~*/**" },
        { "path": "$HOME/[Aa][Pp][Pp][Ll][Ii][Cc][Aa][Tt][Ii][Oo][Nn] [Dd][Aa][Tt][Aa]/**" },
        { "path": "$HOME/[Ll][Oo][Cc][Aa][Ll] [Ss][Ee][Tt][Tt][Ii][Nn][Gg][Ss]/**" },
        { "path": "$HOME/[Ss][Tt][Aa][Rr][Tt] [Mm][Ee][Nn][Uu]/**" },
        { "path": "$HOME/.*" },
        { "path": "$HOME/.*/**" },
        { "path": "$HOME/**/.[Gg][Ii][Tt]/**" },
        { "path": "$HOME/**/*./**" },
        { "path": "$HOME/**/* /**" },
        { "path": "$HOME/**/*~[0-9]*/**" },
        { "path": "$HOME/**/[Ww][Ii][Nn][Dd][Oo][Ww][Ss][Pp][Oo][Ww][Ee][Rr][Ss][Hh][Ee][Ll][Ll]/**" },
        { "path": "$HOME/**/[Pp][Oo][Ww][Ee][Rr][Ss][Hh][Ee][Ll][Ll]/**" },
        { "path": "$DOCUMENT/[Ww][Ii][Nn][Dd][Oo][Ww][Ss][Pp][Oo][Ww][Ee][Rr][Ss][Hh][Ee][Ll][Ll]/**" },
        { "path": "$DOCUMENT/[Pp][Oo][Ww][Ee][Rr][Ss][Hh][Ee][Ll][Ll]/**" },
        { "path": "$DATA/**" },
        { "path": "$LOCALDATA/**" },
        { "path": "$RESOURCE/**" }
      ]
    },
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$APPDATA/**" },
        { "path": "$LOCALDATA/**" },
        { "path": "$TEMP/**" },
        { "path": "$RESOURCE/**" }
      ],
      "deny": [
        { "path": "$HOME/.*" },
        { "path": "$HOME/.*/**" },
        { "path": "$DATA/Microsoft/**" },
        { "path": "$DATA/Mozilla/**" },
        { "path": "$DATA/Opera Software/**" },
        { "path": "$DATA/discord/**" },
        { "path": "$LOCALDATA/Microsoft/**" },
        { "path": "$LOCALDATA/Packages/**" },
        { "path": "$LOCALDATA/Google/**" },
        { "path": "$LOCALDATA/BraveSoftware/**" }
      ]
    },
    "opener:default",
    "opener:allow-open-path",
    "process:allow-restart",
    "updater:default"
  ]
}
